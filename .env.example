# ============ 环境变量模板 ============
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
# 后端服务端口默认 8002，可通过环境变量覆盖

# ---- DeepSeek（生成模型）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- DashScope（Embedding 向量化）----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- MinerU（复杂 PDF / 扫描件解析）----
MINERU_TOKEN=

# ---- 本地精排模型路径（可选，默认 D:/code/ai_demo/models/Qwen3-Reranker-0.6B）----
# RERANKER_MODEL_PATH=D:/models/Qwen3-Reranker-0.6B
